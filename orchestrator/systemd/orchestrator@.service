[Unit]
Description=mYngle Phase-3 Orchestrator job %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=myngle
WorkingDirectory=/home/myngle/orchestrator
ExecStart=/usr/bin/python3 -m core.supervisor --job-id %i
Restart=on-failure
RestartSec=60
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
