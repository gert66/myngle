#!/usr/bin/env bash
set -euo pipefail

REQ="${1:-}"
case "$REQ" in
  /srv/orchestrator-export/_advisory_requests/*.txt) ;;
  *) echo "invalid advisory request path" >&2; exit 64 ;;
esac

[[ -f "$REQ" ]] || { echo "request file not found" >&2; exit 66; }
[[ "$(id -un)" == "hermes" ]] || { echo "must run as hermes" >&2; exit 77; }

cd /srv/orchestrator-export
exec /home/hermes/.local/bin/hermes chat \
  --provider anthropic \
  --toolsets file \
  --skills myngle-orchestrator-loop-diagnosis \
  --query-file "$REQ" \
  --oneshot -Q
